# ============================================================
#  E-commerce — variáveis de ambiente (copie para .env)
#  Nenhum secret real é versionado.
# ============================================================

# --- Ambiente ---
API_ENV=dev                       # dev | prod

# --- Postgres (rede interna Docker; nunca publicado no host) ---
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom-local-dev
POSTGRES_DB=ecom
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (rede interna Docker; nunca publicado no host) ---
REDIS_URL=redis://redis:6379/0

# --- Segurança / JWT ---
API_SECRET_KEY=dev-secret-troque-em-producao
JWT_ACCESS_TTL_SECONDS=900              # 15 min
JWT_REFRESH_TTL_SECONDS=1209600         # 14 dias
PASSWORD_HASH_SCHEME=argon2

# --- CORS / URLs públicas ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_API_URL=http://localhost:8000
SITE_URL=http://localhost:3000

# --- Seed do admin padrão (1º boot) ---
ADMIN_EMAIL=admin@loja.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrador

# --- Storage de mídia ---
STORAGE_BACKEND=local                   # local | s3 (s3 só a partir da fase 9, se preciso)
STORAGE_LOCAL_DIR=/data/media
MEDIA_BASE_URL=http://localhost:8000/media

# --- Backups ---
# Em prod aponte para um VOLUME persistente (docker-compose monta backups:/data/backups),
# senão os .tar.gz são apagados a cada recriação do container.
BACKUP_DIR=/data/backups

# --- Processamento de imagem ---
IMAGE_WEBP_QUALITY=82
IMAGE_THUMB_SIZE=130
IMAGE_MEDIUM_SIZE=600
IMAGE_ZOOM_SIZE=1600

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute

# --- Pagamento: Appmax ---
APPMAX_API_URL=https://homolog.sandboxappmax.com.br/api/v3
APPMAX_ACCESS_TOKEN=
APPMAX_WEBHOOK_SECRET=

# --- Frete: Melhor Envio ---
MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_USER_AGENT=Loja (contato@loja.local)
SHIPPING_ORIGIN_ZIP=01001000
SHIPPING_QUOTE_CACHE_TTL=3600

# --- SMTP (fallback; o admin pode sobrescrever no banco) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=loja@loja.local
SMTP_FROM_NAME=Minha Loja

# --- Frontend (Next.js — loja) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# segredo compartilhado: a API chama POST {SITE_URL}/api/revalidate?secret=... quando
# o admin salva tema/catálogo, pra loja refletir na hora. Vazio = endpoint liberado.
REVALIDATE_SECRET=
# Opcional: base usada só nas chamadas do SSR/RSC (server-side). Em Docker,
# aponte pro serviço interno da API (ex.: http://api:8000) pra evitar a volta
# pela internet/proxy/TLS. Sem isso, o SSR usa NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=

# --- Admin (Next.js — painel) ---
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_BASE_PATH=/administracao
